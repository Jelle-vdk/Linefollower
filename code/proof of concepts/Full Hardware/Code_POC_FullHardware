// 1. De webpagina serveren
void handleRoot() {
  server.send(200, "text/html", HTML_PAGE);
}

// 2. Behandelt M1 én M2 via de parameters ?nr=, ?run=, ?speed=, ?dir=
void handleMotor() {
  int nr = server.arg("nr").toInt();        // 1 of 2
  int run = server.arg("run").toInt();      // 1 (aan) of 0 (uit)
  int speed = server.arg("speed").toInt();  // 0 tot 100 (%)
  String dir = server.arg("dir");           // "fwd" of "rev"

  // 1. Reken het percentage (0-100) om naar 8-bit PWM (0-255)
  int pwmVal = 0;
  if (run == 1) {
    pwmVal = map(speed, 0, 100, 0, 255);
  }

  // 2. Stuur de juiste pinnen van de DRV8833 aan
  if (nr == 1) {
    // MOTOR 1 (H_IN1 & H_IN2)
    if (run == 0 || pwmVal == 0) {
      ledcWrite(H_IN1, 0);
      ledcWrite(H_IN2, 0);
    } else if (dir == "fwd") {
      ledcWrite(H_IN1, pwmVal);
      ledcWrite(H_IN2, 0);
    } else if (dir == "rev") {
      ledcWrite(H_IN1, 0);
      ledcWrite(H_IN2, pwmVal);
    }
  } 
  else if (nr == 2) {
    // MOTOR 2 (H_IN3 & H_IN4)
    if (run == 0 || pwmVal == 0) {
      ledcWrite(H_IN3, 0);
      ledcWrite(H_IN4, 0);
    } else if (dir == "fwd") {
      ledcWrite(H_IN3, pwmVal);
      ledcWrite(H_IN4, 0);
    } else if (dir == "rev") {
      ledcWrite(H_IN3, 0);
      ledcWrite(H_IN4, pwmVal);
    }
  }

  // 3. Pas op het allerlaatst meld je aan de browser dat de opdracht klaar is
  server.send(200, "text/plain", "OK");
}

// 3. Behandelt LED 1 én LED 2 via de parameters ?nr=, ?state=
void handleLed() {
  int nr = server.arg("nr").toInt();
  int state = server.arg("state").toInt();

  // Hier sturen we zo meteen LED_Run of LED_Wifi aan
  if (nr == 1) {
    digitalWrite(LED_Run, state);
  } else if (nr == 2) {
    digitalWrite(LED_Wifi, state);
  }

  server.send(200, "text/plain", "OK");
}

// 4. Bundelt alle sensoren + de knopstatus in één JSON-berichtje
void handleStatus() {
  int btnVal = digitalRead(Btn_Run) == HIGH? 1 : 0; // HIGH bij indrukken (pull-down)

  // Bouw JSON: {"btn": 0, "s": [120, 340, 4000, 3900, 200, 100]}
  String json = "{\"btn\":";
  json += btnVal;
  json += ",\"s\":[";
  for (int i = 0; i < 6; i++) {
    json += analogRead(sensorList[i]);
    if (i < 5) json += ",";
  }
  json += "]}";

  server.send(200, "application/json", json);
}


void setup(){
    //hardware instellen
    pinMode(H_EEP, OUTPUT);
    digitalWrite(H_EEP, HIGH);

    ledcAttach(H_IN1, 20000, 8);
    ledcAttach(H_IN2, 20000, 8);
    ledcAttach(H_IN3, 20000, 8);
    ledcAttach(H_IN4, 20000, 8);
    ledcWrite(H_IN1, 0);
    ledcWrite(H_IN2, 0);
    ledcWrite(H_IN3, 0);
    ledcWrite(H_IN4, 0);

    pinMode(LED_Run, OUTPUT);
    digitalWrite(LED_Run, LOW);
    pinMode(LED_Wifi, OUTPUT);
    digitalWrite(LED_Wifi, LOW);

    pinMode(Btn_Run, INPUT);
    for (int pin: sensorList){
        pinMode(pin, INPUT);
    }

    //Wi-Fi instellen
    WiFi.softAP(ssid, password);

    //koppeling URL's
    server.on("/", handleRoot);
    server.on("/motor", handleMotor);
    server.on("/led", handleLed);
    server.on("/status", handleStatus);

    //server starten
    server.begin();
}


void loop(){
    server.handleClient();
}
